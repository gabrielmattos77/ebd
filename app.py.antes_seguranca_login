@app.route("/restaurar", methods=["GET", "POST"])
@login_obrigatorio
def restaurar():

    if request.method == "GET":
        return render_template("restaurar.html")

    arquivo = request.files.get("backup")

    if not arquivo or arquivo.filename == "":
        return "Nenhum arquivo de backup foi selecionado.", 400

    import os
    import shutil
    import sqlite3

    arquivo_temp = "ebd_restauracao_temp.db"

    # Salva o arquivo enviado temporariamente
    arquivo.save(arquivo_temp)

    # -------------------------------------------------
    # VALIDAÇÃO DO BACKUP
    # -------------------------------------------------

    try:
        conexao_teste = sqlite3.connect(arquivo_temp)
        cursor_teste = conexao_teste.cursor()

        # Verifica integridade do SQLite
        cursor_teste.execute("PRAGMA integrity_check;")
        integridade = cursor_teste.fetchone()

        if not integridade or integridade[0] != "ok":
            conexao_teste.close()
            os.remove(arquivo_temp)

            return (
                "❌ O backup está corrompido ou inválido. "
                "O banco atual não foi alterado.",
                400
            )

        # Verifica as tabelas essenciais do EBD
        cursor_teste.execute("""
            SELECT name
            FROM sqlite_master
            WHERE type = 'table'
        """)

        tabelas = {
            linha[0]
            for linha in cursor_teste.fetchall()
        }

        tabelas_obrigatorias = {
            "alunos",
            "classes",
            "matriculas",
            "domingos",
            "chamadas",
            "visitantes",
            "registros_classe"
        }

        faltando = tabelas_obrigatorias - tabelas

        conexao_teste.close()

        if faltando:
            os.remove(arquivo_temp)

            return (
                "❌ Este arquivo não parece ser um backup válido "
                "do sistema EBD. "
                f"Tabelas ausentes: {', '.join(sorted(faltando))}. "
                "O banco atual não foi alterado.",
                400
            )

    except sqlite3.Error:
        if os.path.exists(arquivo_temp):
            os.remove(arquivo_temp)

        return (
            "❌ O arquivo selecionado não é um banco SQLite válido. "
            "O banco atual não foi alterado.",
            400
        )

    # -------------------------------------------------
    # BACKUP DE SEGURANÇA DO BANCO ATUAL
    # -------------------------------------------------

    seguranca = datetime.now().strftime(
        "ebd_antes_restauracao_%Y-%m-%d_%H-%M-%S.db"
    )

    shutil.copy2(
        "ebd.db",
        seguranca
    )

    # -------------------------------------------------
    # RESTAURAÇÃO
    # -------------------------------------------------

    shutil.move(
        arquivo_temp,
        "ebd.db"
    )

    return """
    <h2>✅ Backup restaurado com sucesso!</h2>
    <p>O banco de dados do EBD foi restaurado.</p>
    <p>Uma cópia do banco anterior também foi criada por segurança.</p>
    <p><a href="/">Voltar para o EBD</a></p>
    """

