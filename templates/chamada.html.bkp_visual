<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chamada — Controle da EBD</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #ffffff;
            color: #000;
        }

        .pagina {
            padding: 10px;
        }

        .cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .cabecalho h1 {
            margin: 0;
            font-size: 28px;
        }

        .voltar {
            text-decoration: none;
            color: #333;
            font-weight: bold;
        }

        .filtros {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .filtro {
            background: white;
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }

        .filtro label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .filtro select {
            min-width: 220px;
            padding: 8px;
        }

        .folha {
            background: white;
            border: 1px solid #000;
            overflow-x: auto;
            box-shadow: none;
        }

        .titulo-folha {
            text-align: center;
            padding: 8px;
            border-bottom: 1px solid #000;
            font-weight: bold;
            font-size: 16px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
            min-width: 1400px;
        }

        th,
        td {
            border: 1px solid #000;
            text-align: center;
            padding: 2px;
            height: 28px;
        }

        th {
            background: #e8e4d5;
            font-size: 13px;
        }

        .mes {
            background: #f0f0f0;
            font-size: 14px;
            font-weight: bold;
            text-align: center;
            height: 35px;
        }

        .dia {
            background: white;
            font-size: 11px;
            font-weight: bold;
            width: 35px;
        }

        .col-numero {
            width: 45px;
        }

        .col-aluno {
            min-width: 280px;
            text-align: left;
        }

        .aluno {
            text-align: left;
            font-weight: bold;
            white-space: nowrap;
        }

        .identificacao {
            display: block;
            font-size: 11px;
            color: #777;
            font-weight: normal;
        }

        .presenca {
            font-weight: bold;
            cursor: pointer;
            width: 35px;
            padding: 5px;
            border: none;
            background: transparent;
        }

        .presente {
            color: #087f23;
        }

        .ausente {
            color: #b00020;
        }

        .sem-registro {
            color: #999;
        }

        .status {
            min-width: 150px;
        }

        .estatisticas-titulo {
            background: #777;
            color: white;
            font-weight: bold;
            text-align: left;
            padding-left: 12px;
        }

        .estatistica {
            background: #f0eee5;
            font-weight: bold;
            text-align: left;
            padding-left: 12px;
        }

        .acoes {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .botao {
            border: none;
            padding: 12px 20px;
            border-radius: 7px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
        }

        .botao-salvar {
            background: #1769aa;
            color: white;
        }

        .botao-voltar {
            background: #ddd;
            color: #222;
        }

        .aviso {
            padding: 15px;
            background: #fff3cd;
            border: 1px solid #e0c56e;
            margin-bottom: 20px;
            border-radius: 7px;
        }
    </style>
</head>

<body>

<div class="pagina">

    <div class="cabecalho">

        <h1>📋 Chamada da EBD</h1>

        <a class="voltar" href="/">
            ← Voltar
        </a>

    </div>


    <div class="filtros">

        <div class="filtro">

            <label>Domingo</label>

            <select id="domingo" onchange="abrirChamada()">

                <option value="">
                    Selecione o domingo
                </option>

                {% for id_domingo, data in domingos %}

                    <option
                        value="{{ id_domingo }}"
                        {% if domingo_id|int == id_domingo %}selected{% endif %}
                    >
                        {{ data[8:10] }}/{{ data[5:7] }}/{{ data[0:4] }}
                    </option>

                {% endfor %}

            </select>

        </div>


        <div class="filtro">

            <label>Classe</label>

            <select id="classe" onchange="abrirChamada()">

                <option value="">
                    Selecione a classe
                </option>

                {% for id_classe, nome_classe in classes %}

                    <option
                        value="{{ id_classe }}"
                        {% if classe_id|int == id_classe %}selected{% endif %}                     
                    >
                        {{ nome_classe }}
                    </option>

                {% endfor %}

            </select>

        </div>

    </div>


    {% if not alunos %}

        <div class="aviso">
            Selecione um domingo e uma classe para visualizar a chamada.
        </div>

    {% else %}

        <div class="folha">

            <div class="titulo-folha">

                CHAMADA —
                {{ classe_selecionada }}

            </div>


            <form method="POST">

                <input
                    type="hidden"
                    name="domingo_id"
                    value="{{ domingo_id }}"
                >

                <input
                    type="hidden"
                    name="classe_id"
                    value="{{ classe_id }}"
                >


                <table>

                    <thead>

                        <!-- LINHA DOS MESES -->

                        <tr>

                            <th
                                class="mes"
                                rowspan="2"
                            >
                                Nº
                            </th>

                            <th
                                class="mes col-aluno"
                                rowspan="2"
                            >
                                ALUNO
                            </th>


                            {% for chave_mes, domingos_mes in domingos_por_mes.items() %}

                                <th
                                    class="mes"
                                    colspan="{{ domingos_mes|length }}"
                                >

                                    {% set ano = chave_mes[0:4] %}
                                    {% set mes = chave_mes[5:7] %}

                                    {% if mes == "01" %}
                                        JANEIRO
                                    {% elif mes == "02" %}
                                        FEVEREIRO
                                    {% elif mes == "03" %}
                                        MARÇO
                                    {% elif mes == "04" %}
                                        ABRIL
                                    {% elif mes == "05" %}
                                        MAIO
                                    {% elif mes == "06" %}
                                        JUNHO
                                    {% elif mes == "07" %}
                                        JULHO
                                    {% elif mes == "08" %}
                                        AGOSTO
                                    {% elif mes == "09" %}
                                        SETEMBRO
                                    {% elif mes == "10" %}
                                        OUTUBRO
                                    {% elif mes == "11" %}
                                        NOVEMBRO
                                    {% elif mes == "12" %}
                                        DEZEMBRO
                                    {% endif %}

                                    / {{ ano }}

                                </th>

                            {% endfor %}


                            <th
                                class="mes"
                                rowspan="2"
                            >
                                STATUS
                            </th>

                        </tr>


                        <!-- LINHA DOS DOMINGOS -->

                        <tr>

                            {% for chave_mes, domingos_mes in domingos_por_mes.items() %}

                                {% for id_domingo, data in domingos_mes %}

                                    <th class="dia">

                                        {{ data[8:10] }}

                                    </th>

                                {% endfor %}

                            {% endfor %}

                        </tr>

                    </thead>


                    <tbody>

                        {% for aluno in alunos %}

                            <tr>

                                <td>
                                    {{ "%02d"|format(loop.index) }}
                                </td>


                                <td class="aluno">

                                    {{ aluno[1] }}

                                    {% if aluno|length > 3 and aluno[3] %}

                                        <span class="identificacao">
                                            {{ aluno[3] }}
                                        </span>

                                    {% endif %}

                                </td>


                                {% for chave_mes, domingos_mes in domingos_por_mes.items() %}

                                    {% for id_domingo, data in domingos_mes %}

                                        <td>

                                            {% set presenca_atual = frequencias.get(aluno[0], {}).get(data) %}
 
                                            <select
                                                name="aluno_{{ aluno[0] }}_{{ id_domingo }}"
                                                class="presenca"
                                            >

                                                <option value="" {% if presenca_atual is none %}selected{% endif %}>

                                                    -
                                                </option>

                                                <option value="P" {% if presenca_atual == 1 %}selected{% endif %}>
                                                    P
                                                </option>

                                                <option value="A" {% if presenca_atual == 0 %}selected{% endif %}>
                                                    A
                                                </option>

                                            </select>

                                        </td>

                                    {% endfor %}

                                {% endfor %}


                                <td class="status">

                                    {% set status = obter_status_aluno(aluno[0]) %}

                                    {% if status.status == "matriculado" %}

                                        <span class="presente">
                                            🟢 Matriculado
                                        </span>

                                    {% elif status.status == "visitante" %}

                                        <span>
                                            🟠 Visitante
                                        </span>

                                    {% else %}

                                        <span class="ausente">
                                            🔴 Não matriculado
                                        </span>

                                    {% endif %}

                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>


                    <tfoot>

                        <tr>
                            <td colspan="100%" class="estatisticas-titulo">
                                ESTATÍSTICAS
                            </td>
                        </tr>

                        {% set matriculados = namespace(total=0) %}
                        {% set presentes = namespace(total=0) %}
                        {% set ausentes = namespace(total=0) %}
                        {% set visitantes = namespace(total=0) %}

                        {% for aluno in alunos %}

                            {% set status_aluno = obter_status_aluno(aluno[0]) %}

                            {% if status_aluno.status == "matriculado" %}
                                {% set matriculados.total = matriculados.total + 1 %}
                            {% endif %}

                            {% if status_aluno.status == "visitante" %}
                                {% set visitantes.total = visitantes.total + 1 %}
                            {% endif %}

                            {% if domingo_selecionado %}
                                {% set presenca = frequencias.get(aluno[0], {}).get(domingo_selecionado) %}

                                {% if presenca == 1 %}
                                    {% set presentes.total = presentes.total + 1 %}
                                {% elif presenca == 0 %}
                                    {% set ausentes.total = ausentes.total + 1 %}
                                {% endif %}
                            {% endif %}

                        {% endfor %}

                        <tr>
                            <td colspan="2" class="estatistica">
                                ALUNOS MATRICULADOS
                            </td>
                            <td colspan="100%">
                                {{ matriculados.total }}
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                PRESENTES
                            </td>
                            <td colspan="100%">
                                {{ presentes.total }}
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                AUSENTES
                            </td>
                            <td colspan="100%">
                                {{ ausentes.total }}
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                VISITANTES
                            </td>
                            <td colspan="100%">
                                {{ visitantes.total }}
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                BÍBLIAS
                            </td>
                            <td colspan="100%">
                                <input
                                   type="number"
                                   name="biblias"
                                   min="0"
                                   value="{{ registro_classe.biblias }}"
                                >
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                REVISTAS
                            </td>
                            <td colspan="100%">
                                <input
                                   type="number"
                                   name="revistas"
                                   min="0"
                                   value="{{ registro_classe.revistas }}"
                                >
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2" class="estatistica">
                                OFERTAS
                            </td>
                            <td colspan="100%">
                                <input
                                   type="number"
                                   name="oferta"
                                   min="0"
                                   step="0.01"
                                   value="{{ registro_classe.oferta }}"
                                >
                            </td>
                        </tr>

                    </tfoot>

                </table>


                <div class="acoes">

                    <button
                        type="submit"
                        class="botao botao-salvar"
                    >
                        💾 Salvar chamada
                    </button>

                    <a
                        href="/"
                        class="botao botao-voltar"
                    >
                        Voltar
                    </a>

                </div>

            </form>

        </div>

    {% endif %}

</div>

<script>
function abrirChamada() {

    const domingo = document.getElementById("domingo").value;
    const classe = document.getElementById("classe").value;

    if (domingo && classe) {

        window.location.href =
            "/chamada?domingo_id=" +
            domingo +
            "&classe_id=" +
            classe;
    }
}
</script>

</body>

</html>
