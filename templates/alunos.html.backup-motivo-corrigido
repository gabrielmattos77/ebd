}

/* ==========================================================
   LISTA DE ALUNOS — ÁREA COMPACTA E ROLÁVEL
   ========================================================== */

.lista-alunos-scroll {

    /* Mostra aproximadamente 3–4 alunos */
    max-height: 185px;

    /* A rolagem acontece somente dentro da lista */
    overflow-y: auto;

    /* Espaço para a barra de rolagem */
    padding-right: 8px;

    margin-top: 15px;

    /* Rolagem suave */
    scroll-behavior: smooth;

}


/* ==========================================================
   BARRA DE ROLAGEM — SUTIL
   ========================================================== */

.lista-alunos-scroll::-webkit-scrollbar {

    width: 4px;

}


.lista-alunos-scroll::-webkit-scrollbar-track {

    background: transparent;

}


.lista-alunos-scroll::-webkit-scrollbar-thumb {

    background: rgba(176, 137, 104, 0.45);

    border-radius: 20px;

}


.lista-alunos-scroll::-webkit-scrollbar-thumb:hover {

    background: rgba(176, 137, 104, 0.75);

}


/* Firefox */

.lista-alunos-scroll {

    scrollbar-width: thin;

    scrollbar-color:
        rgba(176, 137, 104, 0.45)
        transparent;

}

/* ==========================================================
   FIREFOX
   ========================================================== */

.lista-alunos-scroll {

    scrollbar-width: thin;

    scrollbar-color:
        rgba(176, 137, 104, 0.45)
        transparent;

}

/* ==========================================================
   MODAL DO ALUNO — BALÃO SURPRESA
   ========================================================== */

.modal-aluno {

    display: none;

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 9999;

    align-items: center;
    justify-content: center;

    padding: 20px;

    /* Fundo escuro + transparência */
    background: rgba(20, 12, 7, 0.55);

    /* Desfoque do conteúdo atrás do modal */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

}


/* ==========================================================
   BALÃO CENTRAL
   ========================================================== */

.modal-aluno-conteudo {

    width: min(400px, 92vw);

    max-height: 85vh;

    overflow-y: auto;

    padding: 28px 24px;

    background:
        linear-gradient(
            145deg,
            #fffaf2,
            #f4e5d0
        );

    border: 1px solid rgba(176, 137, 104, 0.45);

    border-radius: 24px;

    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.35),
        0 8px 25px rgba(91, 59, 35, 0.20);

    text-align: center;

    animation: aparecerBalãoAluno 0.28s ease-out;

    transform-origin: center center;

}


/* ==========================================================
   ANIMAÇÃO DO BALÃO
   ========================================================== */

@keyframes aparecerBalãoAluno {

    0% {

        opacity: 0;

        transform:
            scale(0.65)
            translateY(25px);

    }

    70% {

        opacity: 1;

        transform:
            scale(1.04)
            translateY(-2px);

    }

    100% {

        opacity: 1;

        transform:
            scale(1)
            translateY(0);

    }

}


/* ==========================================================
   NOME DO ALUNO
   ========================================================== */

.modal-aluno-titulo {

    margin-bottom: 22px;

    padding-bottom: 16px;

    border-bottom:
        1px solid
        rgba(176, 137, 104, 0.30);

}


.modal-aluno-titulo span {

    display: block;

    font-size: 1.35rem;

    font-weight: 700;

    color: #5a3924;

}


/* ==========================================================
   OPÇÕES
   ========================================================== */

.modal-aluno-opcoes {

    display: flex;

    flex-direction: column;

    gap: 10px;

}


/* ==========================================================
   BOTÕES
   ========================================================== */

.modal-aluno-opcoes button {

    width: 100%;

    min-height: 46px;

    padding: 11px 16px;

    border: none;

    border-radius: 12px;

    background: #ead5bb;

    color: #4d3020;

    font-size: 0.95rem;

    font-weight: 600;

    cursor: pointer;

    transition:
        transform 0.15s ease,
        background 0.15s ease,
        box-shadow 0.15s ease;

}


.modal-aluno-opcoes button:hover {

    background: #dfc09c;

    transform: translateY(-2px);

    box-shadow:
        0 5px 12px
        rgba(91, 59, 35, 0.15);

}


.modal-aluno-opcoes button:active {

    transform: scale(0.97);

}


/* ==========================================================
   MOTIVO DA MUDANÇA
   ========================================================== */

.modal-aluno-motivo {

    margin-top: 4px;

    padding: 9px 12px;

    border-radius: 10px;

    background: rgba(176, 137, 104, 0.10);

    color: #8a6548;

    font-size: 0.82rem;

    font-weight: 500;

}


/* ==========================================================
   BOTÃO FECHAR
   ========================================================== */

.modal-aluno-opcoes .botao-fechar-modal {

    margin-top: 8px;

    background: #5a3924;

    color: #fffaf2;

}


.modal-aluno-opcoes .botao-fechar-modal:hover {

    background: #43291a;

}


/* ==========================================================
   BARRA DE ROLAGEM DO BALÃO
   ========================================================== */

.modal-aluno-conteudo::-webkit-scrollbar {

    width: 4px;

}


.modal-aluno-conteudo::-webkit-scrollbar-track {

    background: transparent;

}


.modal-aluno-conteudo::-webkit-scrollbar-thumb {

    background: rgba(176, 137, 104, 0.40);

    border-radius: 20px;

}


/* Firefox */

.modal-aluno-conteudo {

    scrollbar-width: thin;

    scrollbar-color:
        rgba(176, 137, 104, 0.40)
        transparent;

}


/* ==========================================================
   CELULAR
   ========================================================== */

@media (max-width: 480px) {

    .modal-aluno {

        padding: 14px;

    }

    .modal-aluno-conteudo {

        width: 100%;

        padding: 24px 18px;

        border-radius: 20px;

    }

}

/* ==========================================================
   BALÃO SECUNDÁRIO — MOTIVO DA MUDANÇA
   ========================================================== */

.modal-motivo-aluno {

    display: none;
    pointer-events: auto;

    position: fixed;

    left: calc(50% + 210px);
    top: 50%;

    transform:
        translateY(-50%)
        scale(0.85);

    width: 260px;

    min-height: 130px;

    padding: 22px 20px;

    background:
        linear-gradient(
            145deg,
            #fffaf2,
            #f4e5d0
        );

    border:
        1px solid
        rgba(176, 137, 104, 0.45);

    border-radius: 20px;

    box-shadow:
        0 20px 55px rgba(0, 0, 0, 0.28),
        0 6px 20px rgba(91, 59, 35, 0.18);

    z-index: 10000;

    opacity: 0;

    pointer-events: none;

    animation:
        aparecerMotivoAluno
        0.25s
        ease-out
        forwards;

}


/* ==========================================================
   LIGAÇÃO ENTRE OS DOIS BALÕES
   ========================================================== */

.modal-motivo-aluno::before {

    content: "";

    position: absolute;

    left: -13px;

    top: 50%;

    width: 24px;
    height: 24px;

    background: #fffaf2;

    border-left:
        1px solid
        rgba(176, 137, 104, 0.45);

    border-bottom:
        1px solid
        rgba(176, 137, 104, 0.45);

    transform:
        translateY(-50%)
        rotate(45deg);

}


/* ==========================================================
   TÍTULO
   ========================================================== */

.modal-motivo-titulo {

    margin-bottom: 12px;

    padding-bottom: 10px;

    border-bottom:
        1px solid
        rgba(176, 137, 104, 0.30);

    color: #5a3924;

    font-size: 1rem;

    font-weight: 700;

}


/* ==========================================================
   TEXTO DO MOTIVO
   ========================================================== */

.modal-motivo-texto {

    color: #6b4a32;

    font-size: 0.9rem;

    line-height: 1.5;

    text-align: left;

    word-break: break-word;

}


/* ==========================================================
   ANIMAÇÃO
   ========================================================== */

@keyframes aparecerMotivoAluno {

    0% {

        opacity: 0;

        transform:
            translateY(-50%)
            translateX(-15px)
            scale(0.75);

    }

    70% {

        opacity: 1;

        transform:
            translateY(-50%)
            translateX(3px)
            scale(1.03);

    }

    100% {

        opacity: 1;

        transform:
            translateY(-50%)
            translateX(0)
            scale(1);

    }

}


/* ==========================================================
   CELULAR
   ========================================================== */

@media (max-width: 800px) {

    .modal-motivo-aluno {

        left: 50%;

        top: calc(50% + 175px);

        transform:
            translateX(-50%)
            scale(0.85);

        width: min(320px, 88vw);

    }

    @keyframes aparecerMotivoAluno {

        0% {

            opacity: 0;

            transform:
                translateX(-50%)
                translateY(-15px)
                scale(0.75);

        }

        70% {

            opacity: 1;

            transform:
                translateX(-50%)
                translateY(3px)
                scale(1.03);

        }

        100% {

            opacity: 1;

            transform:
                translateX(-50%)
                translateY(0)
                scale(1);

        }

    }

.modal-motivo-aluno {
    pointer-events: auto;
}

.modal-motivo-aluno button {
    position: relative;
    z-index: 10002;
    pointer-events: auto;
    cursor: pointer;
}

.modal-motivo-aluno .motivos-mudanca {
    position: relative;
    z-index: 10001;
    pointer-events: auto;
}

.confirmacao-motivo {
    margin-top: 14px;
    padding: 10px 12px;

    border-radius: 10px;

    font-size: 14px;
    text-align: center;

    opacity: 0;

    transform: translateY(-5px);

    transition:
        opacity 0.2s ease,
        transform 0.2s ease;
}

.confirmacao-motivo.ativo {
    opacity: 1;
    transform: translateY(0);
}

/* ==========================================================
   CONFIRMAÇÃO DO MOTIVO — MINI-ABA
   ========================================================== */

.confirmacao-motivo-mini {

    display: block;

    margin-top: 16px;

    padding: 10px 12px;

    border-radius: 10px;

    background: #e7f4e8;

    border: 1px solid #9ac7a0;

    color: #245c2c;

    font-size: 13px;

    font-weight: 600;

    text-align: center;

}


/* ==========================================================
   BOTÃO DE MOTIVO SELECIONADO
   ========================================================== */

.modal-motivo-aluno
.motivos-mudanca
button.motivo-selecionado {

    background: #7d4b2e;

    color: #ffffff;

    border-color: #7d4b2e;

    transform: scale(1.03);

}

</style>
        
</head>

<body>

<header>
    <h1>👥 Alunos</h1>
    <p>Cadastro e gerenciamento dos alunos</p>
</header>

<div class="container">

    <p>
        <a href="/" class="voltar">← Voltar ao início</a>
    </p>

    <div class="box">

        <h2>➕ Cadastrar aluno</h2>

        <form method="POST" action="/alunos">

            <label>Nome do aluno</label>

            <input
                type="text"
                name="nome"
                placeholder="Ex.: João"
                required
            >

            <label>Identificação / Observação</label>

            <input
                type="text"
                name="identificacao"
                placeholder="Ex.: pai do Pedro"
            >

            <label>Classe</label>

            <select name="classe_id" required>

                <option value="">
                    Selecione a classe
                </option>

                {% for id_classe, nome_classe in classes %}

                    <option value="{{ id_classe }}">
                        {{ nome_classe }}
                    </option>

                {% endfor %}

            </select>

            <button type="submit">
                Cadastrar aluno
            </button>

        </form>

    </div>


    <div class="box">

        <h2>📋 Alunos cadastrados</h2>

        <form method="GET" action="/alunos">

            <label>Escolha uma classe</label>

            <select
                name="classe_id"
                onchange="salvarScrollClasse(this); this.form.submit()"
            >

                <option value="">
                    Selecione a classe
                </option>

                {% for id_classe, nome_classe in classes %}

                    <option
                        value="{{ id_classe }}"
                        {% if classe_id and classe_id|int == id_classe %}
                            selected
                        {% endif %}
                    >
                        {{ nome_classe }}
                    </option>

                {% endfor %}

            </select>

        </form>


                {% if alunos %}

            <h3 class="subtitulo">Alunos atuais</h3>

            <div class="lista-alunos-scroll">

            {% for aluno in alunos %}

                <div
    class="aluno aluno-clicavel"
    id="aluno-{{ aluno[0] }}"
    data-motivo="{{ aluno[5] or '' }}"
    onclick="abrirModalAluno({{ aluno[0] }})"
>

    <div class="nome">
        {{ aluno[1] }}{% if aluno[3] %} ({{ aluno[3] }}){% endif %}
    </div>

</div>

{% endfor %}
                           

        </div>

        {% endif %}


        {% if alunos_historico %}

            <h3 class="subtitulo historico-titulo">
                Histórico da classe
            </h3>

            {% for aluno in alunos_historico %}

                <div class="aluno historico">

                    <div class="nome">

                        <s>{{ aluno[1] }}</s>

                        {% if aluno[5] %}

                            <span class="motivo">
                                ({{ aluno[5] }})
                            </span>

                        {% else %}

                            <span class="motivo">
                                (mudou de classe)
                            </span>

                        {% endif %}

                    </div>

                </div>

            {% endfor %}

        {% elif classe_id and not alunos %}

            <div class="vazio">
                Nenhum aluno cadastrado nesta classe.
            </div>

        {% endif %}            
         

    </div>

</div>

<!-- ==========================================================
     MODAL DO ALUNO
     ========================================================== -->

<div
    id="modal-aluno"
    class="modal-aluno"
    onclick="fecharModalAluno(event)"
>

    <div
        class="modal-aluno-conteudo"
        onclick="event.stopPropagation()"
    >

                <div class="modal-aluno-titulo">
            <span id="modal-aluno-nome"></span>
        </div>


        <!-- ======================================================
             SEÇÃO — EDITAR ALUNO
             ====================================================== -->

        <div
            id="modal-edicao-aluno"
            class="modal-secao-aluno"
            style="display: none;"
        >

            <h3>✏️ Editar aluno</h3>

            <form
                method="POST"
                action="/alunos/editar"
                onsubmit="salvarScrollAntesDoPost()"            
                >

                <input
                    type="hidden"
                    id="editar-aluno-id"
                    name="aluno_id"
                >

                <input
                    type="hidden"
                    name="classe_id"
                    value="{{ classe_id }}"
                >

                <label>Nome do aluno</label>

                <input
                    type="text"
                    id="editar-aluno-nome"
                    name="nome"
                    required
                >

                <label>Identificação / Observação</label>

                <input
                    type="text"
                    id="editar-aluno-identificacao"
                    name="identificacao"
                    placeholder="Ex.: pai do Pedro"
                >

                <button type="submit">
                    💾 Salvar alterações
                </button>

            </form>

            <button
                type="button"
                onclick="voltarMenuAluno()"
            >
                ← Voltar
            </button>

        </div>


        <!-- ======================================================
             SEÇÃO — MUDAR DE CLASSE
             ====================================================== -->

        <div
            id="modal-mudanca-classe"
            class="modal-secao-aluno"
            style="display: none;"
        >

            <h3>🔄 Mudar de classe</h3>

            <form
                method="POST"
                action="/alunos/mudar-classe"
                onsubmit="salvarScrollAntesDoPost()"            
                >

                <input
                    type="hidden"
                    id="mudanca-aluno-id"
                    name="aluno_id"
                >

                <input
                    type="hidden"
                    name="classe_atual_id"
                    value="{{ classe_id }}"
                >

                <label>Nova classe</label>

                <select
                    name="nova_classe_id"
                    required
                >

                    <option value="">
                        Selecione a nova classe
                    </option>

                    {% for id_classe, nome_classe in classes %}

                        <option value="{{ id_classe }}">
                            {{ nome_classe }}
                        </option>

                    {% endfor %}

                </select>

                <label>Motivo da mudança</label>


<div
    id="confirmacao-motivo"
    class="confirmacao-motivo"
>
</div>

<input
    type="hidden"
    id="motivo-mudanca"
    name="motivo"
    required
>

                <button type="submit">
                    🔄 Confirmar mudança
                </button>

            </form>

            <button
                type="button"
                onclick="voltarMenuAluno()"
            >
                ← Voltar
            </button>

        </div>


        <!-- ======================================================
             MENU PRINCIPAL DO ALUNO
             ====================================================== -->

        <div
            id="modal-menu-aluno"
            class="modal-aluno-opcoes"
        >

            <button
                type="button"
                onclick="abrirEdicaoModal()"
            >
                ✏️ Editar
            </button>

<button
    type="button"
    onclick="abrirMudancaClasseModal()"
>
    🔄 Mudar de classe
</button>

<button
    type="button"
    onclick="abrirExclusaoClasseModal()"
>
    🗑️ Excluir da classe
</button>

            <button
                type="button"
                class="botao-fechar-modal"
                onclick="fecharModalAluno()"
            >
                Fechar
            </button>

        </div>

         </div>

    <!-- ======================================================
         BALÃO SECUNDÁRIO — MOTIVO DA MUDANÇA
         ====================================================== -->

    <div
        id="modal-motivo-aluno"
        class="modal-motivo-aluno"
        onclick="event.stopPropagation()"
    >

<div class="modal-motivo-titulo">
    💬 Motivo da mudança
</div>

<div class="motivos-mudanca">

    <button
        type="button"
        onclick="selecionarMotivo('Idade')"
    >
        🎂 Idade
    </button>

    <button
        type="button"
        onclick="selecionarMotivo('Alfabetização')"
    >
        📖 Alfabetização
    </button>

    <button
        type="button"
        onclick="selecionarMotivo('Capacidade')"
    >
        🧠 Capacidade
    </button>

    <button
        type="button"
        onclick="selecionarMotivo('Outros')"
    >
        📝 Outros
    </button>

</div>

</div>

<script>

/*
 * ==========================================================
 * MODAL DO ALUNO — BALÃO SURPRESA
 * ==========================================================
 */

let alunoSelecionado = null;


/*
 * ==========================================================
 * ABRIR MODAL
 * ==========================================================
 */

function abrirModalAluno(alunoId) {

    alunoSelecionado = alunoId;

    const aluno = document.getElementById(
        "aluno-" + alunoId
    );

    if (!aluno) {
        return;
    }


    const nomeElemento = aluno.querySelector(
        ".nome"
    );

    if (!nomeElemento) {
        return;
    }


    const nome = nomeElemento.textContent.trim();


    /*
     * Nome no título
     */

    document.getElementById(
        "modal-aluno-nome"
    ).textContent = nome;


    /*
     * Preenche formulário de edição
     */

    const nomeEdicao =
        document.getElementById(
            "editar-aluno-nome"
        );

    const identificacaoEdicao =
        document.getElementById(
            "editar-aluno-identificacao"
        );

    const idEdicao =
        document.getElementById(
            "editar-aluno-id"
        );

    if (idEdicao) {
        idEdicao.value = alunoId;
    }

    if (nomeEdicao) {

        /*
         * Remove a identificação do nome,
         * caso exista.
         */

        let nomeLimpo = nome;

        const indice =
            nomeLimpo.indexOf(" (");

        if (indice !== -1) {
            nomeLimpo =
                nomeLimpo.substring(0, indice);
        }

        nomeEdicao.value = nomeLimpo;
    }


    /*
     * Identificação / observação
     */

    if (identificacaoEdicao) {

        const identificacao =
            aluno.dataset.identificacao || "";

        identificacaoEdicao.value =
            identificacao;
    }


    /*
     * ID para mudança de classe
     */

    const idMudanca =
        document.getElementById(
            "mudanca-aluno-id"
        );

    if (idMudanca) {
        idMudanca.value = alunoId;
    }


    /*
     * Começa sempre no menu principal.
     */

    mostrarSecaoModal("modal-menu-aluno");


    /*
     * Abre o balão.
     */

    document.getElementById(
        "modal-aluno"
    ).style.display = "flex";

}


/*
 * ==========================================================
 * MOSTRAR SEÇÃO DO MODAL
 * ==========================================================
 */

function mostrarSecaoModal(id) {

    const secoes = [
        "modal-menu-aluno",
        "modal-edicao-aluno",
        "modal-mudanca-classe"
    ];

    secoes.forEach(function(secaoId) {

        const elemento =
            document.getElementById(secaoId);

        if (elemento) {

            elemento.style.display =
                secaoId === id
                    ? "block"
                    : "none";

        }

    });

}

/*
 * ==========================================================
 * FECHAR MODAL
 * ==========================================================
 */

function fecharModalAluno(event) {

    if (
        event &&
        event.target !== event.currentTarget
    ) {
        return;
    }


    document.getElementById(
        "modal-aluno"
    ).style.display = "none";


    alunoSelecionado = null;

}


/*
 * ==========================================================
 * VOLTAR AO MENU
 * ==========================================================
 */

function voltarMenuAluno() {

    mostrarSecaoModal(
        "modal-menu-aluno"
    );

}


/*
 * ==========================================================
 * EDITAR
 * ==========================================================
 */

function abrirEdicaoModal() {

    if (!alunoSelecionado) {
        return;
    }


    const aluno =
        document.getElementById(
            "aluno-" + alunoSelecionado
        );

    if (!aluno) {
        return;
    }


    const nomeElemento =
        aluno.querySelector(".nome");


    const nomeInput =
        document.getElementById(
            "editar-aluno-nome"
        );


    const identificacaoInput =
        document.getElementById(
            "editar-aluno-identificacao"
        );


    const idInput =
        document.getElementById(
            "editar-aluno-id"
        );


    if (idInput) {
        idInput.value =
            alunoSelecionado;
    }


    if (nomeInput && nomeElemento) {

        let nome =
            nomeElemento.textContent.trim();

        const indice =
            nome.indexOf(" (");

        if (indice !== -1) {

            nome =
                nome.substring(
                    0,
                    indice
                );

        }

        nomeInput.value = nome;

    }


    if (identificacaoInput) {

        identificacaoInput.value =
            aluno.dataset.identificacao || "";

    }


    mostrarSecaoModal(
        "modal-edicao-aluno"
    );

}


function abrirMudancaClasseModal() {

    if (!alunoSelecionado) {
        return;
    }


    const idInput =
        document.getElementById(
            "mudanca-aluno-id"
        );


    if (idInput) {

        idInput.value =
            alunoSelecionado;

    }


    /*
     * Primeiro mostra a tela de
     * mudança de classe.
     */
    mostrarSecaoModal(
        "modal-mudanca-classe"
    );


    /*
     * Depois mostra a mini-aba
     * do motivo.
     */
    const miniAba =
        document.getElementById(
            "modal-motivo-aluno"
        );

    if (miniAba) {

        miniAba.style.display =
            "block";

    }

}


/*
 * ==========================================================
 * MOTIVO DA MUDANÇA
 * ==========================================================
 */

function abrirMotivoModal() {

    if (!alunoSelecionado) {
        return;
    }

    const miniAba =
        document.getElementById(
            "modal-motivo-aluno"
        );

    if (!miniAba) {
        return;
    }

    /*
     * Mantém o menu principal aberto
     * e mostra a mini-aba ao lado.
     */

    miniAba.style.display = "block";
    miniAba.style.pointerEvents = "auto";

}

/*
 * ==========================================================
 * PRESERVAÇÃO DO SCROLL — ABA ALUNOS
 * ==========================================================
 */

const CHAVE_SCROLL = "posicaoScrollAlunos";


/*
 * Salva o scroll antes de trocar de classe.
 */

function salvarScrollClasse(select) {

    sessionStorage.setItem(
        CHAVE_SCROLL,
        String(window.scrollY)
    );

}


/*
 * Salva a posição atual antes de qualquer
 * formulário que provoque recarregamento.
 */

function salvarScrollAntesDoPost() {

    sessionStorage.setItem(
        CHAVE_SCROLL,
        String(window.scrollY)
    );

}


/*
 * Restaura o scroll depois que a nova classe
 * foi carregada pelo Flask.
 */

function restaurarScroll() {

    const posicao = sessionStorage.getItem(
        CHAVE_SCROLL
    );

    if (posicao === null) {
        return;
    }

    const valor = parseInt(
        posicao,
        10
    );

    if (Number.isNaN(valor)) {

        sessionStorage.removeItem(
            CHAVE_SCROLL
        );

        return;
    }


    /*
     * Aguarda o navegador terminar a renderização.
     */

    requestAnimationFrame(function() {

        window.scrollTo(
            0,
            valor
        );

    });


    /*
     * Segunda tentativa para evitar
     * pequenos saltos da página.
     */

    setTimeout(function() {

        window.scrollTo(
            0,
            valor
        );

        sessionStorage.removeItem(
            CHAVE_SCROLL
        );

    }, 100);

}

/*
 * ==========================================================
 * SELECIONAR MOTIVO DA MUDANÇA
 * ==========================================================
 */

function selecionarMotivo(motivo) {

    const campo = document.getElementById("motivo-mudanca");

    if (!campo) {
        console.error("Campo motivo-mudanca não encontrado.");
        return;
    }

    campo.value = motivo;

    const miniAba = document.getElementById("modal-motivo-aluno");

    if (!miniAba) {
        console.error("Modal motivo-aluno não encontrado.");
        return;
    }

    const confirmacao = miniAba.querySelector(".confirmacao-motivo");

    if (confirmacao) {
        confirmacao.textContent =
            "✅ Motivo selecionado: " + motivo;

        confirmacao.classList.add("ativo");
    }

    const botoes = miniAba.querySelectorAll(
        ".motivos-mudanca button"
    );

    botoes.forEach(function(botao) {

        botao.classList.remove("motivo-selecionado");

        if (
            botao.textContent
                .toLowerCase()
                .includes(motivo.toLowerCase())
        ) {
            botao.classList.add("motivo-selecionado");
        }

    });

    console.log("Motivo selecionado:", motivo);
}


/*
 * ==========================================================
 * EXCLUIR ALUNO DA CLASSE
 * ==========================================================
 */

function abrirExclusaoClasseModal() {

    if (!alunoSelecionado) {
        return;
    }

    const aluno = document.getElementById(
        "aluno-" + alunoSelecionado
    );

    if (!aluno) {
        return;
    }

    const nomeElemento = aluno.querySelector(
        ".nome"
    );

    const nome = nomeElemento
        ? nomeElemento.textContent.trim()
        : "este aluno";

    const confirmar = confirm(
        "Deseja excluir \"" +
        nome +
        "\" desta classe?"
    );

    if (!confirmar) {
        return;
    }

    const formulario = document.createElement(
        "form"
    );

    formulario.method = "POST";
    formulario.action = "/alunos/excluir-classe";

    formulario.innerHTML = `
        <input
            type="hidden"
            name="aluno_id"
            value="${alunoSelecionado}"
        >

        <input
            type="hidden"
            name="classe_id"
            value="{{ classe_id }}"
        >
    `;

    document.body.appendChild(formulario);

    formulario.submit();
}

/*
 * ==========================================================
 * CARREGAMENTO DA PÁGINA
 * ==========================================================
 */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        restaurarScroll();

    }
);


/*
 * ==========================================================
 * FECHAR MODAL COM ESC
 * ==========================================================
 */

document.addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Escape") {

            fecharModalAluno();

        }

    }
);

</script>

