<body>

<header>
    <h1>👥 Alunos</h1>
    <p>Cadastro e gerenciamento dos alunos</p>
</header>

<div class="container">

    <p>
        <a href="/" class="voltar">← Voltar ao início</a>
    </p>

    <div class="box">

        <h2>➕ Cadastrar aluno</h2>

        <form method="POST" action="/alunos">

            <label>Nome do aluno</label>

            <input
                type="text"
                name="nome"
                placeholder="Ex.: João"
                required
            >

            <label>Identificação / Observação</label>

            <input
                type="text"
                name="identificacao"
                placeholder="Ex.: pai do Pedro"
            >

            <label>Classe</label>

            <select name="classe_id" required>

                <option value="">
                    Selecione a classe
                </option>

                {% for id_classe, nome_classe in classes %}

                    <option value="{{ id_classe }}">
                        {{ nome_classe }}
                    </option>

                {% endfor %}

            </select>

            <button type="submit">
                Cadastrar aluno
            </button>

        </form>

    </div>


    <div class="box">

        <h2>📋 Alunos cadastrados</h2>

        <form method="GET" action="/alunos">

            <label>Escolha uma classe</label>

            <select
                name="classe_id"
                onchange="this.form.submit()"
            >

                <option value="">
                    Selecione a classe
                </option>

                {% for id_classe, nome_classe in classes %}

                    <option
                        value="{{ id_classe }}"
                        {% if classe_id and classe_id|int == id_classe %}
                            selected
                        {% endif %}
                    >
                        {{ nome_classe }}
                    </option>

                {% endfor %}

            </select>

        </form>


                {% if alunos %}

            <h3 class="subtitulo">Alunos atuais</h3>

            <div class="lista-alunos-scroll">

            {% for aluno in alunos %}

                <div
    class="aluno aluno-clicavel"
    id="aluno-{{ aluno[0] }}"
    onclick="abrirModalAluno({{ aluno[0] }})"
>

    <div class="nome">
        {{ aluno[1] }}{% if aluno[3] %} ({{ aluno[3] }}){% endif %}
    </div>

</div>

{% endfor %}
                           

            {% endfor %}

        </div>

        {% endif %}


        {% if alunos_historico %}

            <h3 class="subtitulo historico-titulo">
                Histórico da classe
            </h3>

            {% for aluno in alunos_historico %}

                <div class="aluno historico">

                    <div class="nome">

                        <s>{{ aluno[1] }}</s>

                        {% if aluno[5] %}

                            <span class="motivo">
                                ({{ aluno[5] }})
                            </span>

                        {% else %}

                            <span class="motivo">
                                (mudou de classe)
                            </span>

                        {% endif %}

                    </div>

                </div>

            {% endfor %}

        {% elif classe_id and not alunos %}

            <div class="vazio">
                Nenhum aluno cadastrado nesta classe.
            </div>

        {% endif %}            
         

    </div>

</div>

<script>


function abrirEdicao(alunoId) {

    document.getElementById(
        "edicao-" + alunoId
    ).style.display = "block";

}

function fecharEdicao(alunoId) {

    document.getElementById(
        "edicao-" + alunoId
    ).style.display = "none";

}


/*
 * ==========================================================
 * PRESERVAÇÃO DO SCROLL — ABA ALUNOS
 * ==========================================================
 */

if ("scrollRestoration" in history) {
    history.scrollRestoration = "manual";
}


const CHAVE_SCROLL = "posicaoScrollAlunos";


/*
 * Salva a posição atual
 */
function salvarScroll() {

    sessionStorage.setItem(
        CHAVE_SCROLL,
        String(window.scrollY)
    );

}


/*
 * Restaura a posição salva
 */
function restaurarScroll() {

    const posicao = sessionStorage.getItem(
        CHAVE_SCROLL
    );

    if (posicao === null) {
        return;
    }

    const valor = parseInt(posicao, 10);

    if (Number.isNaN(valor)) {
        sessionStorage.removeItem(CHAVE_SCROLL);
        return;
    }


    /*
     * Primeira tentativa
     */
    window.scrollTo(0, valor);


    /*
     * Segunda tentativa depois da renderização
     */
    requestAnimationFrame(function() {

        window.scrollTo(0, valor);

    });


    /*
     * Terceira tentativa.
     * Isso ajuda quando o navegador ainda está
     * terminando de montar os elementos da página.
     */
    setTimeout(function() {

        window.scrollTo(0, valor);

        sessionStorage.removeItem(
            CHAVE_SCROLL
        );

    }, 100);

}


/*
 * ==========================================================
 * AO CARREGAR A PÁGINA
 * ==========================================================
 */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        restaurarScroll();


        /*
         * Todos os formulários da aba Alunos
         *
         * Isso inclui:
         * - cadastrar aluno
         * - editar aluno
         * - mudar de classe
         * - selecionar classe
         */

        const formularios = document.querySelectorAll(
            "form"
        );


        formularios.forEach(function(formulario) {

            formulario.addEventListener(
                "submit",
                function() {

                    salvarScroll();

                }
            );

        });

    }
);


/*
 * ==========================================================
 * ANTES DE SAIR DA PÁGINA
 * ==========================================================
 *
 * Garante que a posição seja salva mesmo quando
 * o formulário provoca uma navegação normal.
 */

window.addEventListener(
    "beforeunload",
    function() {

        salvarScroll();

    }
);


/*
 * ==========================================================
 * PÁGINA VOLTOU DO HISTÓRICO DO NAVEGADOR
 * ==========================================================
 */

window.addEventListener(
    "pageshow",
    function() {

        restaurarScroll();

    }
);

</script>

