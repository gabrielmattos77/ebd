</div>



<script>


/* =========================================================
   ABRIR CHAMADA
   ========================================================= */

function abrirChamada() {

    const domingo =
        document.getElementById("domingo").value;

    const classe =
        document.getElementById("classe").value;


    if (domingo && classe) {

        sessionStorage.setItem(
            "chamada_scroll",
            window.scrollY
        );


        window.location.href =
            "/chamada?domingo_id=" +
            domingo +
            "&classe_id=" +
            classe;

    }

}


/* =========================================================
   CORES DA PRESENÇA
   ========================================================= */

function atualizarCorPresenca(select) {

    select.classList.remove(
        "presenca-p",
        "presenca-a",
        "presenca-vazia"
    );


    if (select.value === "P") {

        select.classList.add(
            "presenca-p"
        );

    }

    else if (select.value === "A") {

        select.classList.add(
            "presenca-a"
        );

    }

    else {

        select.classList.add(
            "presenca-vazia"
        );

    }

}

function salvarPosicaoScroll() {

    sessionStorage.setItem(
        "chamada_scroll",
        String(window.scrollY)
    );

}


function restaurarPosicaoScroll() {

    const scrollSalvo =
        sessionStorage.getItem("chamada_scroll");

    if (scrollSalvo === null) {
        return;
    }

    const posicao =
        parseInt(scrollSalvo, 10);

    if (isNaN(posicao)) {

        sessionStorage.removeItem(
            "chamada_scroll"
        );

        return;
    }

    /*
     * Desativa temporariamente qualquer comportamento
     * suave de rolagem.
     */
    document.documentElement.style.scrollBehavior = "auto";

    document.body.style.scrollBehavior = "auto";

    /*
     * Restaura a posição diretamente,
     * sem animação.
     */
    window.scrollTo(
        0,
        posicao
    );

    /*
     * Remove a posição depois de restaurar.
     */
    sessionStorage.removeItem(
        "chamada_scroll"
    );

}


window.addEventListener(
    "load",
    function() {

        restaurarPosicaoScroll();

    }
);      

/* =========================================================
   INICIALIZAR CORES
   ========================================================= */

function inicializarCoresPresenca() {

    const selects =
        document.querySelectorAll(
            ".presenca"
        );


    selects.forEach(
        function(select) {

            atualizarCorPresenca(
                select
            );


            select.addEventListener(
                "change",
                function() {

                    atualizarCorPresenca(
                        select
                    );

                }
            );

        }
    );

}



/* =========================================================
   VALIDAR CHAMADA
   ========================================================= */

function validarChamada() {

    const domingo =
        document.getElementById(
            "domingo"
        ).value;


    if (!domingo) {

        alert(
            "⚠️ Selecione um domingo antes de salvar."
        );

        return false;

    }


    const campos =
        document.querySelectorAll(
            'select[name$="_' +
            domingo +
            '"]'
        );


    let incompletos = [];


    campos.forEach(
        function(select) {

            if (select.value === "") {

                const linha =
                    select.closest("tr");


                const nomeElemento =
                    linha?.querySelector(
                        ".aluno"
                    );


                let nome = "";


                if (nomeElemento) {

                    nome =
                        nomeElemento
                            .childNodes[0]
                            ?.textContent
                            .trim();

                }


                incompletos.push(
                    nome ||
                    "Aluno sem nome"
                );

            }

        }
    );


    if (incompletos.length > 0) {

        const modal =
            document.getElementById(
                "modal-chamada-incompleta"
            );


        const lista =
            document.getElementById(
                "lista-incompletos"
            );


        lista.innerHTML = "";


        incompletos.forEach(
            function(nome) {

                const item =
                    document.createElement(
                        "div"
                    );


                item.textContent =
                    nome;


                lista.appendChild(
                    item
                );

            }
        );


        modal.style.display =
            "flex";


        return false;

    }


    return true;

}



/* =========================================================
   FECHAR MODAL
   ========================================================= */

function fecharModalChamada() {

    const modal =
        document.getElementById(
            "modal-chamada-incompleta"
        );


    modal.style.display =
        "none";

}



/* =========================================================
   RESETAR CHAMADA
   ========================================================= */

function resetarChamada() {

    const domingo =
        document.getElementById(
            "domingo"
        ).value;


    const classe =
        document.getElementById(
            "classe"
        ).value;


    if (!domingo || !classe) {

        alert(
            "Selecione um domingo e uma classe antes de resetar."
        );

        return;

    }


    const confirmar =
        confirm(
            "Tem certeza que deseja resetar a chamada deste domingo e desta classe?"
        );


    if (!confirmar) {

        return;

    }


    const formulario =
        document.createElement(
            "form"
        );


    formulario.method =
        "POST";


    formulario.action =
        "/chamada/resetar";


    const campoDomingo =
        document.createElement(
            "input"
        );


    campoDomingo.type =
        "hidden";


    campoDomingo.name =
        "domingo_id";


    campoDomingo.value =
        domingo;



    const campoClasse =
        document.createElement(
            "input"
        );


    campoClasse.type =
        "hidden";


    campoClasse.name =
        "classe_id";


    campoClasse.value =
        classe;


    formulario.appendChild(
        campoDomingo
    );


    formulario.appendChild(
        campoClasse
    );


    document.body.appendChild(
        formulario
    );


    salvarPosicaoScroll();


    formulario.submit();

}



/* =========================================================
   INICIALIZAÇÃO
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        inicializarCoresPresenca();

    }
);

</script>

</body>

