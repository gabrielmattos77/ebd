<!DOCTYPE html>
<html lang="pt-BR">

<head>

     <link rel="manifest" href="{{ url_for('manifest') }}">
     <link rel="icon" type="image/png" href="{{ url_for('static', filename='icons/ebd-logo.png') }}">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Controle da EBD</title>

    <meta name="theme-color" content="#6b4f35">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">

    <style>

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
}

body {
    font-family: Arial, sans-serif;
    background: #faf8f4;
    color: #5b4331;
}


/* =========================================================
   CABEÇALHO
   ========================================================= */

header {
    position: relative;

    width: 100%;
    height: 155px;

    padding: 48px 20px 20px;

    text-align: center;

    background: linear-gradient(
        180deg,
        #f1e3ce 0%,
        #ead7bc 100%
    );
}

header h1 {
    margin: 12px 0 0;

    color: #5b4331;

    font-size: 30px;
    font-weight: 700;

    letter-spacing: 0.2px;

    text-shadow:
        0 1px 3px rgba(80, 55, 35, 0.10);
}

header p {
    display: none;
}


/* =========================================================
   PAINEL DOS BOTÕES
   ========================================================= */

.navegacao {
    position: absolute;

    z-index: 10;

    top: 105px;
    left: 50%;

    transform: translateX(-50%);

    width: 480px;
    max-width: calc(100% - 30px);

    padding: 12px;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 10px;

    background: #fffdf9;

    border: 1px solid #eadbc8;

    border-radius: 18px;

    box-shadow:
        0 12px 28px rgba(80, 55, 35, 0.12),
        0 3px 8px rgba(80, 55, 35, 0.05);
}


/* =========================================================
   BOTÕES
   ========================================================= */

.nav-btn {
    width: 125px;
    height: 95px;

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 8px;

    text-align: center;
    text-decoration: none;

    border-radius: 14px;

    border: 1px solid #dfc29e;

    background: linear-gradient(
        145deg,
        #fff6e8,
        #f1ddc0
    );

    color: #604731;

    font-size: 14px;
    font-weight: 600;

    box-shadow:
        0 4px 9px rgba(90, 61, 37, 0.08);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}


/* =========================================================
   EFEITO AO PASSAR O MOUSE
   ========================================================= */

.nav-btn:hover {
    transform: translateY(-4px) scale(1.025);

    background: linear-gradient(
        145deg,
        #fffaf2,
        #f6e7d1
    );

    color: #523b29;

    border-color: #d6b183;

    box-shadow:
        0 10px 18px rgba(90, 61, 37, 0.14);
}


/* =========================================================
   CLIQUE
   ========================================================= */

.nav-btn:active {
    transform: translateY(-1px) scale(0.99);
}


/* =========================================================
   ÁREA PRINCIPAL
   ========================================================= */

.container {
    width: 100%;
    max-width: 1100px;

    margin: 0 auto;

    padding: 90px 20px 60px;
}


/* =========================================================
   CELULAR
   ========================================================= */

@media (max-width: 700px) {

    header {
        height: 175px;

        padding-top: 45px;
    }

    header h1 {
        margin-top: 10px;

        font-size: 26px;
    }

    .navegacao {
        top: 105px;

        width: 300px;
        max-width: calc(100% - 28px);

        padding: 12px;

        gap: 9px;

        grid-template-columns: repeat(2, 1fr);

        border-radius: 18px;
    }

    .nav-btn {
        width: 100%;
        height: 90px;

        font-size: 13px;

        border-radius: 13px;
    }

    .container {
        padding-top: 130px;
    }
}


/* =========================================================
   ACESSIBILIDADE
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .nav-btn {
        transition: none;
    }
}

</style>

</head>

<body>

    <header>
        <h1>Controle da EBD</h1>
<nav class="navegacao">


    <a href="/" class="nav-btn">
        🏠 Início
    </a>

    <a href="/chamada" class="nav-btn">
        📋 Chamada
    </a>

    <a href="/alunos" class="nav-btn">
        👥 Alunos
    </a>

    <a href="/visitantes" class="nav-btn">
        👤 Visitantes
    </a>

    <a href="/relatorio_diario" class="nav-btn">
        📄 Relatório Diário
    </a>

    <a href="/relatorio_mes" class="nav-btn">
        📊 Relatório Mensal
    </a>
</nav>

    <main class="container"></main>

<script>
if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
        navigator.serviceWorker.register("/static/service-worker.js")
            .then(() => {
                console.log("Service Worker registrado com sucesso.");
            })
            .catch(error => {
                console.error("Erro ao registrar Service Worker:", error);
            });
    });
}
</script>

<!-- CONTROLES DO SISTEMA -->
<div class="controles-sistema">
    <div class="backup-restauracao">
        <a href="/backup" title="Fazer backup">
            💾
        </a>

        <a href="/restaurar" title="Restaurar backup">
            ♻️
        </a>
    </div>

    <a href="/sair" class="sair-discreto" title="Sair do sistema">
        🚪
    </a>
</div>

<style>
.controles-sistema {
    position: fixed;
    right: 18px;
    bottom: 18px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;

    z-index: 9999;
}

.backup-restauracao {
    display: flex;
    align-items: center;
    gap: 5px;
}

.backup-restauracao a,
.sair-discreto {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(107, 79, 53, 0.10);
    color: #6b4f35;

    text-decoration: none;
    font-size: 17px;

    opacity: 0.55;

    transition: all 0.2s ease;
}

.backup-restauracao a:hover,
.sair-discreto:hover {
    opacity: 1;
    background: #6b4f35;
    color: white;
    transform: scale(1.05);
}
</style>

</body>

</html>
