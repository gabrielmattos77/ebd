<!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Relatório Mensal</title>

<style>

body{
    margin:0;
    background:#f5f1e8;
    font-family:Arial, Helvetica, sans-serif;
    color:#2f241d;
}

.container{
    max-width:1400px;
    margin:auto;
    padding:25px;
}

.topo{
    background:#f7f2ea;
    color:#5a4331;
    padding:25px;
    border-radius:18px;
    margin-bottom:20px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.topo h1{
    margin:0;
}

.cards{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));
    gap:15px;
    margin-bottom:20px;
}

.card{
    background:white;
    border-radius:15px;
    padding:20px;
    text-align:center;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.card h3{
    margin:0;
    color:#8b6a4e;
    font-size:14px;
}

.card strong{
    display:block;
    margin-top:10px;
    font-size:30px;
}

.bloco{
    background:white;
    border-radius:18px;
    padding:20px;
    margin-bottom:20px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.bloco h2{
    margin-top:0;
    color:#6b513c;
}

table{
    width:100%;
    border-collapse:collapse;
}

th{
    background:#d8c3a5;
    color:#4d3928;
    padding:12px;
    text-align:center;
}

th:first-child{
    text-align:left;
}

th:last-child{
    text-align:right;
}

td{
    padding:12px;
    border-bottom:1px solid #ececec;
}

.total{
    background:#8b6a4e;
    color:white;
    font-weight:bold;
}

.valor{
    text-align:right;
}

.voltar{
    display:inline-block;
    margin-top:15px;
    background:#8b6a4e;
    color:white;
    text-decoration:none;
    padding:10px 18px;
    border-radius:10px;
    font-weight:bold;
}

</style>
</head>

<body>

<div class="container">

    <div class="topo">

        <h1>
            📊 Relatório Mensal
        </h1>

        <p>
            {{ "%02d"|format(mes) }}/{{ ano }}
        </p>

        <a href="/" class="voltar">
            ← Voltar
        </a>

    </div>


    <div class="cards">

        <div class="card">
            <h3>Total de Ofertas</h3>
            <strong>
                R$ {{ "%.2f"|format(total_ofertas) }}
            </strong>
        </div>

        <div class="card">
            <h3>Total de Bíblias</h3>
            <strong>
                {{ total_biblias }}
            </strong>
        </div>

        <div class="card">
            <h3>Total de Revistas</h3>
            <strong>
                {{ total_revistas }}
            </strong>
        </div>

        <div class="card">
            <h3>Classes</h3>
            <strong>
                {{ resumo_classes|length }}
            </strong>
        </div>

    </div>


    <div class="bloco">

        <h2>
            🏆 Resumo por Classe
        </h2>

        <table>

            <tr>
                <th>Classe</th>
                <th>Bíblias</th>
                <th>Revistas</th>
                <th>Ofertas</th>
            </tr>

            {% for nome, ofertas, biblias, revistas in resumo_classes %}

            <tr>

                <td>
                    {{ nome }}
                </td>

                <td>
                    {{ biblias or 0 }}
                </td>

                <td>
                    {{ revistas or 0 }}
                </td>

                <td class="valor">
                    R$ {{ "%.2f"|format(ofertas or 0) }}
                </td>

            </tr>

            {% endfor %}

        </table>

    </div>


    <div class="bloco">

        <h2>
            💰 Ofertas por Domingo
        </h2>

        <table>

            <tr>
                <th>Data</th>
                <th>Oferta</th>
            </tr>

            {% for data, valor in ofertas %}

            <tr>

                <td>
                    {{ data }}
                </td>

                <td class="valor">
                    R$ {{ "%.2f"|format(valor or 0) }}
                </td>

            </tr>

            {% endfor %}

            <tr class="total">

                <td>
                    TOTAL DO MÊS
                </td>

                <td class="valor">
                    R$ {{ "%.2f"|format(total_ofertas) }}
                </td>

            </tr>

        </table>

    </div>

</div>

</body>
</html><!DOCTYPE html>
<html lang="pt-BR">

<head>
<meta charset="UTF-8">

<title>Relatório Mensal</title>

<style>

body{
    font-family:Arial;
    background:#f5f1e8;
    padding:30px;
}

.card{
    background:white;
    padding:20px;
    border-radius:15px;
    margin-bottom:20px;
}

h1{
    color:#6b513c;
}

</style>

</head>

<body>

<h1>
Relatório {{ "%02d"|format(mes) }}/{{ ano }}
</h1>

<div class="card">

<h2>Ofertas por Domingo</h2>

<table border="1" cellpadding="10">

<tr>
<th>Data</th>
<th>Oferta</th>
</tr>

{% for data, valor in ofertas %}

<tr>
<td>{{ data }}</td>
<td>R$ {{ "%.2f"|format(valor) }}</td>
</tr>

{% endfor %}

</table>

</div>

</body>
</html>
